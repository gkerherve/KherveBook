7.67\", \"F188\": \"279.48\", \"H188\": \"2167.67\", \"A189\": \"279.38\", \"B189\": \"2162.67\", \"F189\": \"279.38\", \"H189\": \"2162.67\", \"A190\": \"279.28\", \"B190\": \"2110.1\", \"F190\": \"279.28\", \"H190\": \"2110.1\", \"A191\": \"279.18\", \"B191\": \"2095.28\", \"F191\": \"279.18\", \"H191\": \"2095.28\", \"A192\": \"279.08\", \"B192\": \"2118.41\", \"F192\": \"279.08\", \"H192\": \"2118.41\"}}], \"active\": \"Sheet1\", \"plots\": []}",
