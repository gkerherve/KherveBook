  {
   "type": "code",
   "source": "# Build a DataFrame from Sheet1, cleaning blanks/None into NaN\ndf = pd.DataFrame(sheet1[1:], columns=sheet1[0])\n\n# Drop columns with no header (NaN/blank column names) and normalize headers to strings\ndf = df.loc[:, [c for c in df.columns if isinstance(c, str) and c.strip() != '']]\ndf.columns = [str(c).strip() for c in df.columns]\n\ndf = df.apply(pd.to_numeric, errors='coerce')\n\nx = df['Binding Energy']\nbg = df['Background'] if 'Background' in df.columns else pd.Series(0, index=df.index)\n\nfig, ax = plt.subplots(figsize=(10, 6))\n\n# Raw data\nax.plot(x, df['Raw Data'], 'o', ms=3, color='black', label='Raw Data')\n\n# Background\nif 'Background' in df.columns:\n    ax.plot(x, bg, '--', color='gray', label='Background')\n\n# Calculated Fit (total envelope)\nif 'Calculated Fit' in df.columns:\n    ax.plot(x, df['Calculated Fit'], '-', color='red', lw=1.5, label='Calculated Fit')\n\n# Individual peaks - fill between Background and peak curve (not from 0)\npeak_cols = [c for c in df.columns if isinstance(c, str) and c.startswith('C1s')]\ncolors = plt.cm.tab10(np.linspace(0, 1, max(len(peak_cols), 1)))\nfor c, col in zip(colors, peak_cols):\n    ax.plot(x, df[col], '-', color=c, lw=1.2, label=col)\n    ax.fill_between(\n        x, bg, df[col],\n        where=(df[col] >= bg),\n        interpolate=True,\n        alpha=0.25, color=c\n    )\n\nax.set_xlabel('Binding Energy (eV)')\nax.set_ylabel('Intensity (a.u.)')\nax.set_title('XPS C1s Spectrum: Raw Data, Background and Fitted Peaks')\nax.invert_xaxis()  # XPS convention: high BE on left\nax.legend(fontsize=8, ncol=2)\n\n# Scientific notation on Y axis, with the x10^n multiplier shown at the top\nax.ticklabel_format(style='sci', axis='y', scilimits=(0, 0))\nax.yaxis.get_offset_text().set_fontsize(9)\n\nfig.tight_layout()\n\nfig"
  }
 ]
