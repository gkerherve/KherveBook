\"J155\": \"0\", \"K155\": \"0\", \"L155\": \"25436.8\", \"M155\": \"920.9\", \"A156\": \"126.68\", \"B156\": \"22933.5\", \"I156\": \"25455.9\", \"J156\": \"0\", \"K156\": \"0\", \"L156\": \"25455.9\", \"M156\": \"1328.7\", \"A157\": \"126.58\", \"B157\": \"23251.9\", \"I157\": \"25475\", \"J157\": \"0\", \"K157\": \"0\", \"L157\": \"25475\", \"M157\": \"614.7\", \"A158\": \"126.48\", \"B158\": \"22359.8\", \"I158\": \"25494.2\", \"J158\": \"0\", \"K158\": \"0\", \"L158\": \"25494.2\", \"M158\": \"1071.6\", \"A159\": \"126.38\", \"B159\": \"23047.9\", \"I159\": \"25513.3\", \"J159\": \"0\", \"K159\": \"0\", \"L159\": \"25513.3\", \"M159\": \"429.3\", \"A160\": \"126.28\", \"B160\": \"22819.4\", \"I160\": \"25532.4\", \"J160\": \"0\", \"K160\": \"0\", \"L160\": \"25532.4\", \"M160\": \"1164.5\", \"A161\": \"126.18\", \"B161\": \"22415.3\", \"I161\": \"25551.5\", \"J161\": \"0\", \"K161\": \"0\", \"L161\": \"25551.5\", \"M161\": \"886.1\", \"A162\": \"126.08\", \"B162\": \"23032.4\", \"I162\": \"25570.6\", \"J162\": \"0\", \"K162\": \"0\", \"L162\": \"25570.6\", \"M162\": \"478.9\"}}], \"active\": \"Sheet5\", \"plots\": [{\"title\": \"Plot\", \"png\": \"\"}, {\"title\": \"Plot\", \"png\": \"\"}, {\"title\": \"Plot\", \"png\": \"\"}]}"
