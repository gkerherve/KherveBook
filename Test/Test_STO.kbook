   "type": "code",
   "source": "# KherveSheet =PY cell Sheet5!G1\n# XPS Peak Fitting with Residuals Analysis and Data Output\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.optimize import curve_fit\n\n# Read XPS data from columns A and B\nx_data = []\ny_data = []\nrow = 2\nwhile row < 300:\n    try:\n        x_val = ks(f\"A{row}\")\n        y_val = ks(f\"B{row}\")\n        if not (np.isnan(x_val) or np.isnan(y_val) or x_val == 0):\n            x_data.append(x_val)\n            y_data.append(y_val)\n            row += 1\n        else:\n            break\n    except:\n        break\n\n# Convert to numpy arrays and sort by binding energy\nx = np.array(x_data)\ny = np.array(y_data)\nsort_idx = np.argsort(x)\nx = x[sort_idx]\ny = y[sort_idx]\n\n# Read fitting range from C1 and C2\ntry:\n    low_be = ks(\"C1\")   # 127.0 - LOW binding energy endpoint\n    high_be = ks(\"C2\")  # 136.4 - HIGH binding energy endpoint\n    print(f\"Linear background from {low_be:.1f} to {high_be:.1f} eV\")\nexcept:\n    low_be = 130.0\n    high_be = 136.0\n\n# Filter data to fitting range\nfit_mask = (x >= low_be) & (x <= high_be)\nx_fit = x[fit_mask]\ny_fit = y[fit_mask]\n\n# Get the baseline values AT the C1 and C2 positions\n# Find data points closest to C1 and C2\nc1_idx = np.argmin(np.abs(x_fit - low_be))\nc2_idx = np.argmin(np.abs(x_fit - high_be))\n\n# Take baseline as the minimum values near the endpoints\n# Look at a few points around each endpoint to find baseline\nedge_width = max(3, len(x_fit)//20)  # Use 3 points or 5% of data, whichever is larger\n\nbaseline_c1 = np.min(y_fit[:edge_width])  # Baseline at low BE end\nbaseline_c2 = np.min(y_fit[-edge_width:])  # Baseline at high BE end\n\n# Calculate linear background parameters\nbg_slope = (baseline_c2 - baseline_c1) / (high_be - low_be)\nbg_intercept = baseline_c1 - bg_slope * low_be\n\nprint(f\"Background line: y = {bg_slope:.2f} * x + {bg_intercept:.1f}\")\nprint(f\"At {low_be:.1f} eV: {baseline_c1:.1f}, at {high_be:.1f} eV: {baseline_c2:.1f}\")\n\n# Find peak positions by looking for maxima above the linear background\nbg_fit_region = bg_slope * x_fit + bg_intercept\ny_above_bg = y_fit - bg_fit_region\n\n# Find peaks above background\nfrom scipy.signal import find_peaks\npeaks_idx, properties = find_peaks(y_above_bg, height=np.max(y_above_bg)*0.1, distance=len(x_fit)//10)\n\nif len(peaks_idx) >= 2:\n    # Sort by peak height and take two strongest\n    peak_heights = [y_above_bg[i] for i in peaks_idx]\n    sorted_peaks = sorted(zip(peak_heights, peaks_idx), reverse=True)\n    peak1_pos = x_fit[sorted_peaks[0][1]]\n    peak2_pos = x_fit[sorted_peaks[1][1]]\nelse:\n    # Default positions if peak finding fails\n    peak1_pos = low_be + (high_be - low_be) * 0.3\n    peak2_pos = low_be + (high_be - low_be) * 0.7\n\n# Define fitting function with LINEAR background from C1 to C2\ndef fit_function(x, amp1, center1, width1, amp2, center2, width2):\n    # Fixed linear background from C1 to C2 baseline levels\n    background = bg_slope * x + bg_intercept\n    peak1 = amp1 * np.exp(-((x - center1)**2) / (2 * width1**2))\n    peak2 = amp2 * np.exp(-((x - center2)**2) / (2 * width2**2))\n    return background + peak1 + peak2\n\n# Initial parameter estimation (no background params since they're fixed)\npeak_height_est = np.max(y_above_bg) * 0.6\n\ninitial_params = [\n    peak_height_est,     # amp1\n    peak1_pos,           # center1\n    0.8,                 # width1\n    peak_height_est,     # amp2  \n    peak2_pos,           # center2\n    0.8                  # width2\n]\n\n# Set bounds for peak parameters only\nbounds = (\n    [0, low_be, 0.1, 0, low_be, 0.1],  # lower bounds\n    [np.max(y_fit)*3, high_be, 3.0, np.max(y_fit)*3, high_be, 3.0]   # upper bounds\n)\n\ntry:\n    # Perform the fit (background is fixed)\n    popt, pcov = curve_fit(fit_function, x_fit, y_fit, p0=initial_params, \n                          bounds=bounds, maxfev=15000)\n    amp1, center1, width1, amp2, center2, width2 = popt\n    \n    # Calculate fit components for the full x range using FIXED background\n    background = bg_slope * x + bg_intercept\n    peak1 = amp1 * np.exp(-((x - center1)**2) / (2 * width1**2))\n    peak2 = amp2 * np.exp(-((x - center2)**2) / (2 * width2**2))\n    total_fit = background + peak1 + peak2\n    residuals = y - total_fit\n    \n    # Write headers to columns I-M\n    ks_set(\"I1\", \"Background\")\n    ks_set(\"J1\", \"Peak 1\") \n    ks_set(\"K1\", \"Peak 2\")\n    ks_set(\"L1\", \"Total Fit\")\n    ks_set(\"M1\", \"Residuals\")\n    \n    # Write fitting data to spreadsheet\n    for i in range(len(x)):\n        ks_set(f\"I{i+2}\", round(background[i], 1))\n        ks_set(f\"J{i+2}\", round(peak1[i], 1))\n        ks_set(f\"K{i+2}\", round(peak2[i], 1))\n        ks_set(f\"L{i+2}\", round(total_fit[i], 1))\n        ks_set(f\"M{i+2}\", round(residuals[i], 1))\n    \n    # Calculate fit quality metrics for the fitted region\n    fit_residuals = y_fit - fit_function(x_fit, *popt)\n    ss_res = np.sum(fit_residuals**2)\n    ss_tot = np.sum((y_fit - np.mean(y_fit))**2)\n    r_squared = 1 - (ss_res / ss_tot) if ss_tot > 0 else 0\n    rms_residual = np.sqrt(np.mean(fit_residuals**2))\n    \n    # Create the plots\n    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8), height_ratios=[3, 1])\n    \n    # Main XPS plot\n    ax1.plot(x, y, 'ko', markersize=2, label='Experimental Data', alpha=0.7)\n    ax1.plot(x, total_fit, 'r-', linewidth=2, label='Total Fit')\n    ax1.plot(x, background, 'b--', linewidth=2, label=f'Linear Background ({low_be:.1f}\u2192{high_be:.1f} eV)')\n    ax1.plot(x, background + peak1, 'g--', linewidth=1.5, label=f'Peak 1 ({center1:.1f} eV)')\n    ax1.plot(x, background + peak2, 'm--', linewidth=1.5, label=f'Peak 2 ({center2:.1f} eV)')\n    \n    # Mark the C1 and C2 endpoints\n    ax1.plot([low_be, low_be], [0, np.max(y)*1.1], 'k:', alpha=0.5)\n    ax1.plot([high_be, high_be], [0, np.max(y)*1.1], 'k:', alpha=0.5)\n    ax1.text(low_be, np.max(y)*0.9, f'C1\\n{low_be:.1f}', ha='center', fontsize=8)\n    ax1.text(high_be, np.max(y)*0.9, f'C2\\n{high_be:.1f}', ha='center', fontsize=8)\n    \n    ax1.set_ylabel('Intensity (counts)')\n    ax1.set_title(f'XPS Peak Fitting with Linear Background (R\u00b2 = {r_squared:.4f})')\n    ax1.legend(loc='upper left', fontsize=9)\n    ax1.grid(True, alpha=0.3)\n    ax1.invert_xaxis()\n    \n    # Residuals plot\n    ax2.plot(x, residuals, 'ro', markersize=1.5, alpha=0.6)\n    ax2.axhline(y=0, color='black', linestyle='-', linewidth=1)\n    ax2.axhline(y=rms_residual, color='gray', linestyle='--', alpha=0.7, label=f'\u00b1{rms_residual:.0f}')\n    ax2.axhline(y=-rms_residual, color='gray', linestyle='--', alpha=0.7)\n    ax2.axvspan(low_be, high_be, alpha=0.15, color='yellow', label='Fit Region')\n    \n    ax2.set_xlabel('Binding Energy (eV)')\n    ax2.set_ylabel('Residuals')\n    ax2.set_title(f'Fit Residuals (RMS = {rms_residual:.1f})')\n    ax2.legend(fontsize=8)\n    ax2.grid(True, alpha=0.3)\n    ax2.invert_xaxis()\n    \n    plt.tight_layout()\n    \n    # Print fit summary\n    print(f\"Fit Results with Fixed Linear Background:\")\n    print(f\"Background: {bg_intercept:.1f} + {bg_slope:.3f}*x (from C1 to C2)\")\n    print(f\"Peak 1: {center1:.2f} eV, FWHM={width1*2.355:.2f} eV, Area={amp1*width1*np.sqrt(2*np.pi):.0f}\")\n    print(f\"Peak 2: {center2:.2f} eV, FWHM={width2*2.355:.2f} eV, Area={amp2*width2*np.sqrt(2*np.pi):.0f}\")\n    print(f\"R\u00b2 = {r_squared:.4f}, RMS = {rms_residual:.1f}\")\n    \nexcept Exception as e:\n    print(f\"Fitting failed: {str(e)}\")\n    \n    # Create simple plot if fit fails\n    fig = plt.figure(figsize=(8, 5))\n    plt.plot(x, y, 'ko', markersize=3)\n    # Show the intended linear background\n    bg_line = bg_slope * x + bg_intercept\n    plt.plot(x, bg_line, 'b--', label=f'Linear Background C1\u2192C2')\n    plt.axvline(low_be, color='red', linestyle=':', alpha=0.7, label=f'C1 ({low_be:.1f})')\n    plt.axvline(high_be, color='red', linestyle=':', alpha=0.7, label=f'C2 ({high_be:.1f})')\n    plt.xlabel('Binding Energy (eV)')\n    plt.ylabel('Intensity (counts)')\n    plt.title('XPS Data with Linear Background (Fit Failed)')\n    plt.legend()\n    plt.grid(True, alpha=0.3)\n    plt.gca().invert_xaxis()\n\n# Return the plot\nplt.gcf()",
   "height": 721
