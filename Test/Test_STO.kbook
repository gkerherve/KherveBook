   "source": "# Read XPS data from sheet into pandas DataFrame\nimport pandas as pd\n\n# Read all data from columns A and B\nx_data = []\ny_data = []\nrow = 2\n\nwhile row < 300:\n\ttry:\n\t\tx_val = ks(f\"A{row}\")\n\t\ty_val = ks(f\"B{row}\")\n\t\tif x_val is None or y_val is None:\n\t\tbreak\n\tif not (np.isnan(float(x_val)) or np.isnan(float(y_val))):\n\t\tx_data.append(float(x_val))\n\t\ty_data.append(float(y_val))\n\t\trow += 1\n\texcept:\n\t\tbreak\n\n# Create DataFrame\ndf = pd.DataFrame({\n'Binding Energy (eV)': x_data,\n'Intensity': y_data\n})\n\n# Sort by binding energy\ndf = df.sort_values('Binding Energy (eV)').reset_index(drop=True)\n\nprint(f\"Loaded {len(df)} data points\")\nprint(f\"\\nDataFrame info:\")\nprint(df.info())\nprint(f\"\\nFirst few rows:\")\nprint(df.head())\nprint(f\"\\nLast few rows:\")\nprint(df.tail())\n\ndf"
